{
  "manifest_version": 3,
  "name": "言序 · KnowGrove 剪藏",
  "version": "0.3.6",
  "description": "把当前文章或视频交给本机 KnowGrove 整理，并保存到 Obsidian。",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:47831/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "整理当前页面到 Obsidian",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
